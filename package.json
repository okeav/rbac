{
  "name": "@okeav/rbac-core",
  "version": "0.1.0",
  "description": "Standalone, pluggable RBAC engine for Node.js/TypeScript backends — accountType/accountSubType/role/userType/capabilities permission model, wildcard scope matching, and framework middleware. Bring your own scope catalogue and identity claims.",
  "type": "module",
  "license": "MIT",
  "author": "Okeav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okeav/rbac.git"
  },
  "homepage": "https://github.com/okeav/rbac#readme",
  "bugs": {
    "url": "https://github.com/okeav/rbac/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    },
    "./middleware/express": {
      "import": "./src/middleware/express/index.js",
      "types": "./types/middleware-express.d.ts"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "express": "^4.18 || ^5.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  },
  "keywords": [
    "rbac",
    "permissions",
    "authorization",
    "capabilities",
    "scopes",
    "access-control"
  ]
}
